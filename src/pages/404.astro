---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/format';
---

<Base title="Página no encontrada" noindex>
  <div class="simple wrap">
    <span class="caps mute">Error 404</span>
    <h1 class="title wide">No está</h1>
    <p>Esta página no existe o cambió de dirección.</p>
    <a class="line-link caps" href={withBase('/')}>
      Volver al inicio
      <Icon name="right" />
    </a>
  </div>
</Base>
