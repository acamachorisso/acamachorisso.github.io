---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getSite } from '../lib/content';
import { paragraphs, withBase } from '../lib/format';
import { img } from '../lib/media';

const site = await getSite();
---

<Base title="Sobre mí" description={site.bio_lead} image={site.portrait} current="sobre-mi">
  <div class="bio wrap">
    <div class="portrait">
      <Image
        src={img(site.portrait)}
        alt={`Retrato de ${site.name}`}
        widths={[480, 800, 1100]}
        sizes="(max-width: 900px) 100vw, 45vw"
        loading="eager"
      />
    </div>
    <div class="text">
      <h1 class="title title-md wide">Sobre mí</h1>
      <p class="body">{site.bio_lead}</p>
      {paragraphs(site.bio).map((p) => <p class="body" set:html={p} />)}
      <div class="ctas caps">
        <a class="btn" href={withBase('/contacto/')}>
          Escribime
          <Icon name="right" />
        </a>
      </div>
    </div>
  </div>
</Base>
