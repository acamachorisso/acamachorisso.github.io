---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Icon from '../components/Icon.astro';
import { albumsLabel, getPhotoGroups, getShowreel, getSite, getVideoGroups, videoSummary } from '../lib/content';
import { withBase } from '../lib/format';
import { img } from '../lib/media';

const [site, photoGroups, videoGroups, showreel] = await Promise.all([
  getSite(),
  getPhotoGroups(),
  getVideoGroups(),
  getShowreel(),
]);
const albumCount = photoGroups.reduce((n, g) => n + g.albums.length, 0);
const showreelUrl = showreel?.data.youtube
  ? `https://www.youtube.com/watch?v=${showreel.data.youtube}`
  : showreel?.data.file
    ? withBase(showreel.data.file)
    : undefined;
const poster = await getImage({ src: img(site.hero_poster), width: 1920, format: 'webp' });
---

<Base current="inicio" nav={false}>
  <header class="hero" slot="hero">
    <video
      class="hero-media"
      poster={poster.src}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-src={withBase(site.hero_video)}
      data-hero-video></video>
    <div class="shade"></div>
    <Nav current="inicio" over />
    <div class="hero-copy wrap">
      <h1 class="name wide">{site.name}</h1>
      <p class="role caps">{site.tagline}</p>
      {
        showreelUrl && (
          <a class="cta caps" href={showreelUrl} rel="noopener">
            Ver showreel
            <Icon name="right" />
          </a>
        )
      }
    </div>
    <a class="hero-down caps" href="#trabajo">
      <span class="hero-down-icon" aria-hidden="true"><Icon name="down" size={16} /></span>
      Ver trabajos
    </a>
  </header>

  <section class="about wrap" aria-labelledby="sobre-mi">
    <!-- En el celular la foto se recorta alrededor de Agustín y se ve más ampliada: necesita la versión grande. -->
    <Image
      class="about-bg"
      src={img(site.about_background)}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="(max-width: 760px) 250vw, 100vw"
    />
    <div class="about-in">
      <h2 id="sobre-mi" class="about-title wide">Sobre mí</h2>
      <p class="about-text">{site.bio_short}</p>
      <a class="line-link caps" href={withBase('/sobre-mi/')}>
        Leer más
        <Icon name="right" />
      </a>
    </div>
  </section>

  {
    (videoGroups.length > 0 || photoGroups.length > 0) && (
      <section id="trabajo" class="work wrap" aria-labelledby="trabajo-t">
        <div class="work-head">
          <h2 id="trabajo-t" class="h2 wide">
            Trabajo
          </h2>
        </div>
        <div class="tiles">
          {photoGroups.length > 0 && (
            <a class="tile" href={withBase(`/fotos/${photoGroups[0].slug}/`)}>
              <Image src={img(site.photos_cover)} alt="" widths={[600, 900, 1400]} sizes="(max-width: 760px) 100vw, 50vw" />
              <span class="tile-label">
                <span class="tile-title wide">Fotos</span>
                <span class="tile-meta caps">
                  {albumsLabel(albumCount)}
                  <Icon name="right" />
                </span>
              </span>
            </a>
          )}
          {videoGroups.length > 0 && (
            <a class="tile" href={withBase('/videos/')}>
              <Image src={img(site.videos_cover)} alt="" widths={[600, 900, 1400]} sizes="(max-width: 760px) 100vw, 50vw" />
              <span class="tile-label">
                <span class="tile-title wide">Videos</span>
                <span class="tile-meta caps">
                  {videoSummary(videoGroups)}
                  <Icon name="right" />
                </span>
              </span>
            </a>
          )}
        </div>
      </section>
    )
  }
</Base>

<script>
  // El video del inicio empieza a cargar cuando el resto de la página ya terminó:
  // primero se ven el nombre y la imagen fija, y enseguida arranca el video, sin sonido y en loop.
  // Arranca aunque el dispositivo tenga "reducir movimiento": en Windows se activa solo con apagar las
  // animaciones del sistema, y Agustín quiere que el video se vea en todos lados (26/11).
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const start = () => {
    if (!video?.dataset.src) return;
    video.src = video.dataset.src;
    video.muted = true;
    video.play().catch(() => {
      // Algunos celulares (el iPhone en ahorro de batería) no dejan que un video arranque solo:
      // ahí arranca con el primer toque o tecla.
      const events = ['touchend', 'click', 'keydown'];
      const retry = () => {
        video.play().catch(() => {});
        for (const type of events) window.removeEventListener(type, retry, true);
      };
      for (const type of events) window.addEventListener(type, retry, { capture: true, passive: true });
    });
  };
  if (document.readyState === 'complete') start();
  else window.addEventListener('load', start, { once: true });
</script>
