---
import { getNav, getSite } from '../lib/content';
import { withBase } from '../lib/format';

interface Props {
  current?: string;
}
const { current } = Astro.props;
const [site, nav] = await Promise.all([getSite(), getNav()]);
const pages = nav.filter((item) => item.key !== current && item.key !== 'contacto');
const year = new Date().getFullYear();
// En la compu, las columnas comparten filas (título + un renglón por link) y el copyright va
// en la fila del último link de Redes (TikTok), aunque Páginas tenga más links.
const rows = 1 + Math.max(2, site.links.length, pages.length);
const copyRow = 1 + (site.links.length || 2);
---

<footer class="foot wrap" style={`--rows: ${rows}; --copy-row: ${copyRow}`}>
  <div class="foot-brand">
    <div class="foot-id">
      <p class="foot-name wide">{site.name}</p>
      <p class="foot-sub">{[site.tagline, site.location].filter(Boolean).join(' · ')}</p>
    </div>
    <p class="copy">© {year} {site.name}</p>
  </div>
  <div>
    <h2 class="caps">Contacto</h2>
    <ul>
      <li><a href={withBase('/contacto/')}>Escribime</a></li>
      <li>
        <a href={`mailto:${site.email}`}>
          {site.email.split('@')[0]}<wbr />@{site.email.split('@')[1]}
        </a>
      </li>
    </ul>
  </div>
  {
    site.links.length > 0 && (
      <div>
        <h2 class="caps">Redes</h2>
        <ul>
          {site.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <div>
    <h2 class="caps">Páginas</h2>
    <ul>
      {
        pages.map((item) => (
          <li>
            <a href={withBase(item.href)}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
